{
  "name": "steamsync",
  "version": "1.0.3",
  "description": "SteamSync for Dota 2 by Freaks",
  "author": "Freak",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "release": "electron-vite build && electron-builder && npm run clean",
    "preview": "electron-vite preview",
    "clean": "node -e \"const{rmSync,existsSync}=require('fs');['dist/win-unpacked','dist/builder-debug.yml'].forEach(f=>{if(existsSync(f))rmSync(f,{recursive:true,force:true})})\""
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^35.1.5",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.4"
  }
}
